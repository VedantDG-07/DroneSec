# DroneSec Environment Configuration Template
# Copy to .env for local overrides (never commit production secrets to version control)

# Operational Environment (development | production)
APP_ENV=development

# Server Host & Port (Least Privilege: bind to 127.0.0.1 for local SITL)
SIM_HOST=127.0.0.1
SIM_PORT=8000

# CORS Allowed Origins (Comma-separated list; wildcard '*' is strictly prohibited in production)
SIM_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:3000,http://localhost:3000

# Active Security Mode (UNSECURED | INTEGRITY_ONLY | ENCRYPTED_AUTHENTICATED)
SIM_SECURITY_MODE=UNSECURED

# Cryptographic Keys (Hex-encoded 32-byte / 256-bit keys)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Mandatory when APP_ENV=production and security_mode != UNSECURED
# SIM_AES_256_KEY=
# SIM_HMAC_SHA256_KEY=

# Ground Control Station Credentials
# Mandatory when APP_ENV=production (cannot use demo token 'gcs-sim-token-secret-2026')
SIM_GCS_BEARER_TOKEN=gcs-sim-token-secret-2026
SIM_AUTHORIZED_SENDER=GCS-PRIMARY

# Replay Protection & Rate Limiting Parameters
SIM_TIMESTAMP_WINDOW_SECONDS=5.0
SIM_SEQUENCE_WINDOW_SIZE=64
SIM_RATE_LIMIT_CAPACITY=20
SIM_RATE_LIMIT_REFILL_RATE=10.0

# Request Body Limit (Bytes)
SIM_MAX_REQUEST_BYTES=65536
